<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- macOS 使用：launchd 服务标识，保持唯一即可。 -->
  <key>Label</key>
  <string>com.vpnkeepalive</string>

  <!-- macOS 使用：这里改成你实际发布后的 VpnKeepAlive 可执行文件路径。 -->
  <key>ProgramArguments</key>
  <array>
    <string>/usr/local/vpnkeepalive/VpnKeepAlive</string>
  </array>

  <!-- macOS 使用：工作目录会影响 logs/ 和 appsettings.json 的读取位置。 -->
  <key>WorkingDirectory</key>
  <string>/usr/local/vpnkeepalive</string>

  <!-- macOS 使用：开机/加载后自动启动。 -->
  <key>RunAtLoad</key>
  <true/>

  <!-- macOS 使用：进程退出后自动拉起，适合保活服务。 -->
  <key>KeepAlive</key>
  <true/>

  <!-- macOS 使用：launchd 自身的 stdout/stderr 日志；程序业务日志仍在 logs/。 -->
  <key>StandardOutPath</key>
  <string>/usr/local/vpnkeepalive/logs/launchd.out.log</string>
  <key>StandardErrorPath</key>
  <string>/usr/local/vpnkeepalive/logs/launchd.err.log</string>
</dict>
</plist>
